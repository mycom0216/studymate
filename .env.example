# 이 파일을 ".env"로 복사한 뒤 사용할 키만 채우세요. .env는 git에 올라가지 않습니다.
# 키가 하나도 없으면 LLM 없이 "자료 원문 발췌(추출형)" 답변과 규칙 기반 퀴즈로 동작합니다.

# Claude (Anthropic)
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-5-5

# ChatGPT (OpenAI)
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# 사용할 공급자: auto(기본: Claude 키 → OpenAI 키 → 로컬 Ollama 순) | anthropic | openai | ollama | off
# LLM_PROVIDER=auto
# OLLAMA_MODEL=kanana2:3b

# 카카오 오픈빌더 스킬 서버(POST /kakao/skill). 설정하면 스킬 URL 끝에 ?token=값 을 붙여야 응답합니다.
# KAKAO_SKILL_TOKEN=

# PORT=5300
# EMBEDDINGS=on   # Ollama의 embeddinggemma 임베딩을 BM25와 섞어 검색(선택)
